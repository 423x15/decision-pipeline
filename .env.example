# Copy this file to .env and fill in your keys
# cp .env.example .env

# --- Required for LLM synthesis (Mistral is the default) ---
MISTRAL_API_KEY=your_mistral_api_key_here

# --- Required for JEV Pipeline engine only ---
# Create a key at https://console.typesafe.ai/
TYPESAFE_API_KEY=your_typesafe_api_key_here

# --- Alternative LLM providers (optional) ---
# Set LLM_PROVIDER=openai or LLM_PROVIDER=anthropic to switch
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- LLM override (optional) ---
# LLM_PROVIDER=mistral
# LLM_MODEL=mistral-small-latest
